# Add these in Vercel Project Settings -> Environment Variables.
# Never commit real secret values to GitHub.
#
# This app only ever calls Supabase as `anon` (RLS already allows anon
# insert/select/update on `entries` - see the-archive-living-memory app,
# which uses the same key). There is no service-role secret in this repo.

SUPABASE_URL=https://YOUR_PROJECT_REFERENCE.supabase.co
SUPABASE_ANON_KEY=YOUR_PROJECT_ANON_OR_PUBLISHABLE_KEY
